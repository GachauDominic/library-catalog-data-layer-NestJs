# Neon direct endpoint for API queries and Prisma migrations (no -pooler).
DIRECT_URL="postgresql://USER:PASSWORD@EP-example.REGION.aws.neon.tech/DB?sslmode=require"

# Optional pooled fallback; the Prisma Postgres runtime currently cannot use Neon's pooler.
DATABASE_URL="postgresql://USER:PASSWORD@EP-example-pooler.REGION.aws.neon.tech/DB?sslmode=require"

JWT_SECRET="replace-with-a-long-random-secret"
PORT=3000
# Comma-separated browser origins; use exact origins without trailing slashes.
CLIENT_URL="http://localhost:5173,https://your-frontend.example.com"
